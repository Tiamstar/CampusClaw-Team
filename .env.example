# Run python scripts/setup_local.py to create random local credentials.
DJANGO_SECRET_KEY=
POSTGRES_DB=campus
POSTGRES_USER=campus
POSTGRES_PASSWORD=
# For real SMTP: set host, port, account, authorization password and TLS below.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=CampusClaw <no-reply@campusclaw.local>
# Protocol: mock | openai | anthropic (not the vendor name).
# OpenAI-compatible: MODEL_API_BASE=https://your-gateway.example/v1
# Anthropic-compatible: MODEL_API_BASE=https://api.anthropic.com
# Both accept a root URL or a URL ending in /v1; no endpoint suffix.
# MODEL_NAME must be the exact ID supplied by your gateway.
MODEL_PROVIDER=mock
MODEL_API_BASE=
MODEL_API_KEY=
MODEL_NAME=
# Anthropic prefers this key, falling back to MODEL_API_KEY.
ANTHROPIC_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=2048

# 本地 MCP 示例；公网部署时更换令牌。外部服务需加入允许的主机名。
MCP_ALLOWED_HOSTS=campus-tools
MCP_CAMPUS_TOKEN=

# 隔离执行代理令牌：backend 与 MCP 服务保持一致
SANDBOX_TOKEN=

APP_PORT=5174
API_PORT=8001
DB_PORT=5434
MAIL_PORT=8026
SMTP_PORT=1026
MCP_PORT=8101
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
COOKIE_SECURE=0
# Trust only the bundled Nginx, which overwrites X-Real-IP; keep backend private.
AUTH_TRUST_PROXY_IP=1
# These defaults stay disabled for the direct local HTTP stack. The dedicated
# deploy/compose.production.yml enables them behind a private backend socket.
DJANGO_TRUST_PROXY_TLS=0
DJANGO_HTTPS_ONLY=0
DJANGO_HSTS_SECONDS=0
# Provisional operational alert persistence, not an agreed course SLO.
SKILL_ALERT_FOR_SECONDS=120
SKILL_ALERT_RECOVERY_SECONDS=120
SKILL_ALERT_MAX_GAP_SECONDS=90
