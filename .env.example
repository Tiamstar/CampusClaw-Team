# Run python scripts/setup_local.py to create random local credentials.
DJANGO_SECRET_KEY=
POSTGRES_DB=campus
POSTGRES_USER=campus
POSTGRES_PASSWORD=
# For real SMTP: set host, port, account, authorization password and TLS below.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=CampusClaw <no-reply@campusclaw.local>
MODEL_PROVIDER=mock
MODEL_API_BASE=
MODEL_API_KEY=
MODEL_NAME=
ANTHROPIC_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=2048

# 本地 MCP 示例；公网部署时更换令牌。外部服务需加入允许的主机名。
MCP_ALLOWED_HOSTS=campus-tools
MCP_CAMPUS_TOKEN=

# 隔离执行代理令牌：backend 与 MCP 服务保持一致
SANDBOX_TOKEN=

APP_PORT=5174
API_PORT=8001
DB_PORT=5434
MAIL_PORT=8026
SMTP_PORT=1026
MCP_PORT=8101
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
COOKIE_SECURE=0
